{
  "name": "dcv",
  "version": "0.1.0",
  "private": true,
  "description": "Decentralized Credentials Vault System - local-only W3C Verifiable Credentials demo",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p scripts/tsconfig.json",
    "test:contracts": "node scripts/foundry.mjs forge test --root packages/contracts",
    "chain": "node scripts/foundry.mjs anvil --chain-id 31337 --port 8545",
    "deploy:local": "tsx scripts/deploy.ts",
    "build:contracts": "node scripts/build-contracts.mjs",
    "env:init": "node scripts/env-init.mjs",
    "dev": "node scripts/dev.mjs",
    "ipfs": "node scripts/ipfs.mjs",
    "reset": "node scripts/reset.mjs",
    "stop:issuer": "node scripts/stop-issuer.mjs",
    "e2e": "tsx scripts/e2e.ts",
    "privacy-scan": "tsx scripts/privacy-scan.ts",
    "e2e:full": "node scripts/e2e-full.mjs",
    "pw": "playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.13.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "@dcv/core": "workspace:*",
    "viem": "2.56.8"
  }
}
