# Decentralized Credentials Vault - local demo configuration.
# Every value is optional; the defaults live in packages/core/src/config.ts (see PLAN.md section 11).
# Nothing here requires registration with any external service.

# Chain (local Anvil)
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Anvil's well-known test keys - safe ONLY because the chain is local.
ADMIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
ISSUER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# Issuer / verifier / wallet
ISSUER_NAME=Anvil State University
ISSUER_PORT=4001
ISSUER_PUBLIC_URL=http://localhost:4001
VERIFIER_PORT=4002
VERIFIER_PUBLIC_URL=http://localhost:4002
WALLET_URL=http://localhost:5173

# IPFS (local Kubo, offline mode)
IPFS_API_URL=http://127.0.0.1:5001
IPFS_GATEWAY_URL=http://127.0.0.1:8080
IPFS_PATH=./.ipfs

# Protocol parameters
STATUS_LIST_SIZE=131072
# Demo values: long enough that pre-created requests survive a 10-minute demo.
NONCE_TTL_SECONDS=600
KB_MAX_AGE_SECONDS=300
DEPLOYMENTS_FILE=deployments/anvil.json

# Browser apps (Vite only exposes VITE_* variables)
VITE_RPC_URL=http://127.0.0.1:8545
VITE_ISSUER_URL=http://localhost:4001
VITE_VERIFIER_API_URL=http://localhost:4002
VITE_IPFS_API_URL=http://127.0.0.1:5001
VITE_IPFS_GATEWAY_URL=http://127.0.0.1:8080
# Demo value: never auto-lock the wallet mid-demo (idle-based; default 300).
VITE_AUTO_LOCK_SECONDS=900

PLAYWRIGHT_BASE_URL=http://localhost:5174
